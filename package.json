{
    "name": "wishgranter.dev",
    "version": "1.0.0",
    "description": "",
    "main": "dist/build.js",
    "type": "module",
    "scripts": {
        "lint": "stylelint --fix **.css",
        "clean": "shx rm -rf dist public",
        "prebuild": "npm run clean",
        "build": "tsc -p node_modules/wishgranter/ --noCheck && eleventy",
        "preview": "tsc -p node_modules/wishgranter/ --noCheck && eleventy --serve",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sleeper-Society/wishgranter.dev.git"
    },
    "keywords": [],
    "author": "",
    "license": "CC4.0-SA",
    "bugs": {
        "url": "https://github.com/Sleeper-Society/wishgranter.dev/issues"
    },
    "homepage": "https://github.com/Sleeper-Society/wishgranter.dev#readme",
    "devDependencies": {
        "@11ty/eleventy": "^3.1.7",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@types/node": "^25.9.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.4",
        "shx": "^0.4.0",
        "stylelint": "^17.13.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "wishgranter": "github:Sleeper-Society/HDC-Wishgranter"
    },
    "lint-staged": {
        "*.css": "stylelint --fix",
        "*.{ts,html,css,md,yml}": "prettier --write"
    }
